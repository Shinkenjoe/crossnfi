###  https://www.easi.uni-bayreuth.de/crossnfi#StateOwner
:StateOwner rdf:type owl:Class ;
            rdfs:subClassOf :OwnerGroup ;
            rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
            skos:definition "an area owned by the state"^^xsd:string ;
