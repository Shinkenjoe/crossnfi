@prefix : <https://www.easi.uni-bayreuth.de/crossnfi#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://www.easi.uni-bayreuth.de/crossnfi> .

<https://www.easi.uni-bayreuth.de/crossnfi> rdf:type owl:Ontology ;
                                             owl:versionIRI <https://www.easi.uni-bayreuth.de/crossnfi_0.1> ;
                                             dcterms:description "An ontology to enable ODBA access for national forest inventories (NFI)"@en ;
                                             rdfs:label "crossnfi ontology 0.1"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#broader
skos:broader rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#closeMatch
skos:closeMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#note
skos:note rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty ;
               rdfs:subPropertyOf rdfs:label .


###  https://www.easi.uni-bayreuth.de/crossnfi#def
:def rdf:type owl:AnnotationProperty ;
     rdfs:label "def"@en .


###  https://www.easi.uni-bayreuth.de/crossnfi#pref
:pref rdf:type owl:AnnotationProperty ;
      rdfs:label "pref"@en .


#################################################################
#    Object Properties
#################################################################

###  http://www.opengis.net/ont/geosparql#sfContains
geo:sfContains rdf:type owl:ObjectProperty ;
               owl:inverseOf geo:sfWithin ;
               skos:note "2d-spatial parthood (location) in the sense of Keet, 2025, Ontology Engineering"@en .


###  http://www.opengis.net/ont/geosparql#sfWithin
geo:sfWithin rdf:type owl:ObjectProperty ;
             skos:note "2d-spatial parthood (location) in the sense of Keet, 2025, Ontology Engineering"@en .


###  https://www.easi.uni-bayreuth.de/crossnfi#assignedByArea
:assignedByArea rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :assignedToStratum ;
                owl:inverseOf :containsPlotByArea ;
                rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
                skos:note "The plot gets assigned to the stratum by the map subarea it is contained in being assigned to the stratum area corresponding to this stratum"@en ;
                skos:prefLabel "asignado por área"@es ,
                               "assigned by area"@en ,
                               "zugewiesen durch Fläche"@de .


###  https://www.easi.uni-bayreuth.de/crossnfi#assignedByCondition
:assignedByCondition rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :assignedToStratum ;
                     owl:inverseOf :containsPlotByCondition ;
                     rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
                     skos:note "the plot is assigned to the stratum by the entities it desrcibes satisfying the conditions of the stratum"@en ;
                     skos:prefLabel "asignado por condición"@es ,
                                    "assigned by condition"@en ,
                                    "zugewiesen durch Bedingung"@de .


###  https://www.easi.uni-bayreuth.de/crossnfi#assignedToStratum
:assignedToStratum rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :isPartOf ;
                   owl:inverseOf :hasPlotAssigned ;
                   rdfs:domain :Stratum ;
                   rdfs:range :Plot ;
                   rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
                   skos:prefLabel "asignado al estrato"@es ,
                                  "assigned to stratum"@en ,
                                  "zugewiesen zum Stratum"@de .


###  https://www.easi.uni-bayreuth.de/crossnfi#collectedOnArea
:collectedOnArea rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf owl:topObjectProperty ;
                 owl:inverseOf :isPlaceForDataRecordingFor ;
                 rdfs:domain :DataCollection ;
                 rdfs:range :PlotArea ;
                 rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
                 skos:note """Domain: a sample or a collection of data like a national forest inventory, a cluster or a plot
Range:  a plot area"""@en ;
                 skos:prefLabel "aufgenommen auf"@de ,
                                "fichado en"@es ,
                                "recorded on"@en .


###  https://www.easi.uni-bayreuth.de/crossnfi#contains
:contains rdf:type owl:ObjectProperty ;
          rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
          skos:note "structural parthood in the sense of Keet, 2025 Ontology Engineering"@en ;
          skos:prefLabel "contains"@en ,
                         "contienes"@es ,
                         "enhält"@de .


###  https://www.easi.uni-bayreuth.de/crossnfi#containsPlotByArea
:containsPlotByArea rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :hasPlotAssigned ;
                    rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
                    skos:definition "the stratum contains a plot by the plot being located in a map subarea assigned to the stratum"@en ;
                    skos:prefLabel "contains plot by area"@en ,
                                   "contiene parcela por área"@es ,
                                   "enthält Plot durch Fläche"@de .


###  https://www.easi.uni-bayreuth.de/crossnfi#containsPlotByCondition
:containsPlotByCondition rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf :hasPlotAssigned ;
                         rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
                         skos:note "the stratum contains a plot by the plot satisfying its conditions"@en ;
                         skos:prefLabel "contains plot by condition"@en ,
                                        "contiene parcela por condición"@es ,
                                        "enthält Plot durch Bedingung"@de .


###  https://www.easi.uni-bayreuth.de/crossnfi#describedByPlot
:describedByPlot rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :desrcibedBy ;
                 owl:inverseOf :hasAsPlot ;
                 rdfs:range :Plot ;
                 rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
                 skos:note """Domain: 
entities for which there is data to be found at a plot. These entities are samples (of trees or other entitities), area and its terrain, forest community, forest processes

Range: 
Plot"""@en ;
                 skos:prefLabel "beschriebenVonPlot"@de ,
                                "describedByPlot"@en ,
                                "describidoDeParcela"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#describes
:describes rdf:type owl:ObjectProperty ;
           rdfs:domain :DataCollection ;
           rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
           skos:definition "a data  collection like a Plot describes an entity if it has data about it"@en ;
           skos:prefLabel "beschreibt"@de ,
                          "describes"@en ,
                          "describes"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#desrcibedBy
:desrcibedBy rdf:type owl:ObjectProperty ;
             rdfs:range :DataCollection ;
             rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
             skos:definition "an enitiy is described by a ddata collection if the latter has data about the former"@en ;
             skos:prefLabel "beschrieben von"@de ,
                            "described by"@en ,
                            "describido de"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#hasAsPlot
:hasAsPlot rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :describes ;
           rdfs:domain :Plot ;
           skos:note """Domain: 
Plot

Range: 
entities for which there is data to be found at a plot. These entities are samples (of trees or other entitities), area and its terrain, forest community, forest processes"""@en ;
           skos:prefLabel "beschreibtAlsPlot"@de ,
                          "describesAsPlot"@en ,
                          "describesComoParcela"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#hasAspect
:hasAspect rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :hasQuality ;
           rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
           skos:definition "relates a plot subarea to its aspect"@en ;
           skos:prefLabel "has aspect"@en ,
                          "hat Exposition"@de ,
                          "tiene orientación"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#hasAzimuth
:hasAzimuth rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :hasQuality ;
            rdfs:range :Azimuth ;
            rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
            skos:definition "relates a spatial entitiy to its azimuth in s planar coordinate system"@en ;
            skos:prefLabel "has azimuth"@en ,
                           "hat Azimuth"@de ,
                           "tiene azimuth"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#hasCount
:hasCount rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf :hasQuality ;
          rdfs:domain :AngleCountSample ;
          rdfs:range :AngleCount ;
          rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
          skos:definition "relates an angle count sample to one of its angle counts"@en ;
          skos:prefLabel "has count"@en ,
                         "hat Anzahl"@de ,
                         "tiene conteo"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#hasDBH
:hasDBH rdf:type owl:ObjectProperty ;
        rdfs:subPropertyOf :hasQuality ;
        rdfs:domain :Tree ;
        rdfs:range :DBH ;
        rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
        skos:definition "relates a tree with its diameter at breast height"@en ;
        skos:prefLabel "has DBH"@en ,
                       "hat BHD"@de ,
                       "tiene DAP"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#hasDistance
:hasDistance rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :hasQuality ;
             rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
             skos:note "relates a spatial entity to its distance in a planar coordinate system"@en ;
             skos:prefLabel "has distance"@en ,
                            "hat Enternung"@de ,
                            "tiene distancia"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#hasHeight
:hasHeight rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :hasQuality ;
           rdfs:domain :Tree ;
           rdfs:range :TreeHeight ;
           rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
           skos:definition "relatzes a tree to its height"@en ;
           skos:prefLabel "hasHeight"@en ,
                          "hat Höhe"@de ,
                          "tiene altura"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#hasMinDBH
:hasMinDBH rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :hasQuality ;
           rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
           skos:definition "relates a sample of Trees above"@en ;
           skos:prefLabel "has minimum DBH"@en ,
                          "hat Mindest-BHD"@de ,
                          "tiene DAP  mínima"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#hasOwnerGroup
:hasOwnerGroup rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :isClassifiedAs ;
               rdfs:domain :PlotSubArea ;
               rdfs:range :OwnerGroup ;
               rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
               skos:definition "relates a plot subabrea to its owner group classification"@en ;
               skos:prefLabel "has owner group"@en ,
                              "hat Eigentümergruppe"@de ,
                              "tiene grupo de propietario"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#hasPlotAssigned
:hasPlotAssigned rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :contains ;
                 rdfs:domain :Stratum ;
                 rdfs:range :Plot ;
                 rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
                 skos:definition "relates a stratum to one of its plots"^^xsd:string ;
                 skos:prefLabel "has plot assigned"@en ,
                                "hat Plot zugewiesen"@de ,
                                "tiene plot asignado"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#hasQuality
:hasQuality rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf owl:topObjectProperty ;
            rdfs:range :Quality ;
            rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
            skos:definition "relates an entity to one of its qualities"@en ;
            skos:prefLabel "has quality"@en ,
                           "hat Qualität"@de ,
                           "tiene calidad"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#hasSlope
:hasSlope rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf :hasQuality ;
          rdfs:domain :PlotSubArea ;
          rdfs:range :Slope ;
          rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
          skos:definition "relates a plot subarea (terrain) to its slope"^^xsd:string ;
          skos:prefLabel "has slope"@en ,
                         "hat Neigung"@de ,
                         "tiene pendiente"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#isClassifiedAs
:isClassifiedAs rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :hasQuality ;
                rdfs:range :Classification ;
                rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
                skos:definition "connects  an entity to one of its classifications"@en ;
                skos:prefLabel "es clasificado como"@es ,
                               "is classified as"@en ,
                               "ist klassifiziert als"@de .


###  https://www.easi.uni-bayreuth.de/crossnfi#isPartOf
:isPartOf rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf owl:topObjectProperty ;
          skos:note "structural parthood in the sense of Keet, 2025, Ontology Engineering"@en ;
          skos:prefLabel "es parte de"@es ,
                         "is part of"@en ,
                         "ist Teil von"@de .


###  https://www.easi.uni-bayreuth.de/crossnfi#isPlaceForDataRecordingFor
:isPlaceForDataRecordingFor rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf owl:topObjectProperty ;
                            rdfs:domain :PlotArea ;
                            rdfs:range :DataCollection ;
                            rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
                            skos:note """Domain: plot area
Range: a sample or data collections like a national forest inventory, a cluster or a plot"""@en ;
                            skos:prefLabel "es lugar de registro de datos de"@es ,
                                           "is place of data recording for"@en ,
                                           "ist Ort der Datenaufnahme von"@de .


###  https://www.easi.uni-bayreuth.de/crossnfi#isStageFor
:isStageFor rdf:type owl:ObjectProperty ;
            owl:inverseOf :takesPlaceIn ;
            rdfs:domain :Region ;
            rdfs:range :Process ;
            rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
            skos:prefLabel "es escenarío de"@es ,
                           "is stage for"@en ,
                           "ist Bühne für"@de .


###  https://www.easi.uni-bayreuth.de/crossnfi#satisfiesStratum
:satisfiesStratum rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf owl:topObjectProperty ;
                  rdfs:domain :Plot ;
                  rdfs:range :Stratum ;
                  rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
                  skos:definition "a plot satisfies the condition set by a stratum"@en ;
                  skos:note "a plot can satisfy a stratum's conditions but still be assigned to a different stratum if the assigation happens by map polygons"@en ;
                  skos:prefLabel "erfüllt Stratum"@de ,
                                 "satisface estrato"@es ,
                                 "satisfies stratum"@en .


###  https://www.easi.uni-bayreuth.de/crossnfi#takesPlaceIn
:takesPlaceIn rdf:type owl:ObjectProperty ;
              rdfs:domain :Process ;
              rdfs:range :Region ;
              rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
              skos:prefLabel "findet statt in"@de ,
                             "ocurres en"@es ,
                             "takes place in"@en .


#################################################################
#    Data properties
#################################################################

###  https://www.easi.uni-bayreuth.de/crossnfi#inYear
:inYear rdf:type owl:DatatypeProperty ;
        rdfs:range xsd:integer ;
        skos:note """relates time indexed entities to a year,

For Forest Inventories this is either the year of the cutoff date (BWI, IFN) or the year most of the measurements took place (FIA). Other time indexed entities inherit their time index by the Forest Inventory they are related to.

The datatype is `xsd:integer` because OWL does not use `xsd:gYear` and `xsd:datetime` is too cumbersome"""@en ;
        skos:prefLabel "en el año"@es ,
                       "im Jahr"@de ,
                       "in year"@en .


#################################################################
#    Classes
#################################################################

###  http://qudt.org/schema/qudt/Quantity
qudt:Quantity rdf:type owl:Class ;
              dcterms:description """<p>A <b>Quantity</b> is the measurement of an observable property of a particular object, event, or physical system. 
  A quantity is always associated with the context of measurement (i.e. the thing measured, the measured value, the accuracy of measurement, etc.) whereas the 
  underlying <b>quantity kind</b> is independent of any particular measurement. Thus, length is a quantity kind while the height of a rocket is a specific 
  quantity of length; its magnitude that may be expressed in meters, feet, inches, etc. Examples of physical quantities include physical constants, such as 
  the speed of light in a vacuum, Planck's constant, the electric permittivity of free space, and the fine structure constant. </p>
<p>In other words, quantities are quantifiable aspects of the world, such as the duration of a movie, the distance between two points, 
velocity of a car, the pressure of the atmosphere, and a person's weight; and units are used to describe their numerical measure.</p> 
<p>Many <b>quantity kinds</b> are related to each other by various physical laws, and as a result, the associated units of some quantity 
kinds can be expressed as products (or ratios) of powers of other quantity kinds (e.g., momentum is mass times velocity and velocity is defined as distance 
divided by time). In this way, some quantities can be calculated from other measured quantities using their associations to the quantity kinds in these 
expressions. These quantity kind relationships are also discussed in dimensional analysis. Those that cannot be so expressed can be regarded 
as \"fundamental\" in this sense.</p>
<p>A quantity is distinguished from a \"quantity kind\" in that the former carries a value and the latter is a type specifier.
</p>""" .


###  https://www.easi.uni-bayreuth.de/crossnfi#AbioticProcess
:AbioticProcess rdf:type owl:Class ;
                rdfs:subClassOf :Process ;
                rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
                skos:definition "a process where the main actor is abiotic, most often a metereoloical force or condition that is deviating from the normal condition or force."@en ,
                                "proceso abiótico"@es ;
                skos:prefLabel "abiotic process"@es ,
                               "abiotischer Prozess"@de .


###  https://www.easi.uni-bayreuth.de/crossnfi#AngleCount
:AngleCount rdf:type owl:Class ;
            rdfs:subClassOf :Quantity ;
            skos:definition "number of trees counted in an angle count sample"@de ;
            skos:note """Instances are related by ´qudt:hasUnit' to a ´qudt:Unit´, which ´qudt:hasQuantityKind´ ´quantitkind:Count´. This usually is ´unit:COUNT´

Thes counts usually are diiferentiated by tree spescies to which this quantity realtes to by the property  ´ofSpecies´ 

TODO: It would be better to integrate the count of a certain basal area factor as unit in QUDT."""@en ;
            skos:prefLabel "Winkelanzahl"@de ,
                           "angle count"@en ,
                           "conteo angular relascópico"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#AngleCountOfBasalAreaFactor1m2
:AngleCountOfBasalAreaFactor1m2 rdf:type owl:Class ;
                                rdfs:subClassOf :AngleCount ;
                                rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
                                rdfs:label "angle count of basal area factor 1 m²"@en ;
                                skos:definition "number of trees counted in an angle count sample of basal area factor 1 m²"@en ;
                                skos:note """Instances are related by ´qudt:hasUnit' to a ´qudt:Unit´, which ´qudt:hasQuantityKind´ ´quantitkind:Count´. This usually is ´unit:COUNT´

Thes counts usually are diiferentiated by tree spescies to which this quantity realtes to by the property  ´ofSpecies´ 

TODO: It would be better to integrate the count of a certain basal area factor as unit in QUDT."""@en ;
                                skos:prefLabel "Winkelanzahl mit Zählfaktor 4 m²"@de ,
                                               "conteo angular relascópico de factor de proporcionalidad de 4 m²"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#AngleCountOfBasalAreaFactor2m2
:AngleCountOfBasalAreaFactor2m2 rdf:type owl:Class ;
                                rdfs:subClassOf :AngleCount ;
                                rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
                                skos:definition "number of trees counted in an angle count sample of basal area factor 4 m²"@en ;
                                skos:note """Instances are related by ´qudt:hasUnit' to a ´qudt:Unit´, which ´qudt:hasQuantityKind´ ´quantitkind:Count´. This usually is ´unit:COUNT´

Thes counts usually are diiferentiated by tree spescies to which this quantity realtes to by the property  ´ofSpecies´ 

TODO: It would be better to integrate the count of a certain basal area factor as unit in QUDT."""@en ;
                                skos:prefLabel "Winkelanzahl mit Zählfaktor 4 m²"@de ,
                                               "angle count of basal area factor 2 m²"@en ,
                                               "conteo angular relascópico de factor de proporcionalidad de 4 m²"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#AngleCountOfBasalAreaFactor4m2
:AngleCountOfBasalAreaFactor4m2 rdf:type owl:Class ;
                                rdfs:subClassOf :AngleCount ;
                                rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
                                rdfs:label "angle count of basal area factor 4 m²"@en ;
                                skos:definition "number of trees counted in an angle count sample of basal area factor 4 m²"@en ;
                                skos:note """Instances are related by ´qudt:hasUnit' to a ´qudt:Unit´, which ´qudt:hasQuantityKind´ ´quantitkind:Count´. This usually is ´unit:COUNT´

Thes counts usually are diiferentiated by tree spescies to which this quantity realtes to by the property  ´ofSpecies´ 

TODO: It would be better to integrate the count of a certain basal area factor as unit in QUDT."""@en ;
                                skos:prefLabel "Winkelanzahl mit Zählfaktor 4 m²"@de ,
                                               "conteo angular relascópico de factor de proporcionalidad de 4 m²"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#AngleCountSample
:AngleCountSample rdf:type owl:Class ;
                  rdfs:subClassOf :SampleOfTreesOfMinDiameter ;
                  rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
                  skos:definition "A set of trees that is assigned to a central point by satisfying a certain diameter-distance requiremement. An Angle Count Sample is attributed by a basal area factor (BAF). A tree belongs to the Angle Count Sample, if and only if the relation of its diameter at breast height (in cm)  to its distance to the central point (in m) surpasses a minimum relation constant,  which corresponds to the basal area factor (eg. BAF 4 m² has the relation of ¹/₂₅)"@en ;
                  skos:note """Often the trees in the sample are not rerred to individually but just counted, most often distuished by species. A count is refered to by the property 'cnfi:hasCount' and notes the corresponding species. For some angle count samples though the individual trees are recorded.

The count of trees in an angle count sample is in a statistical relationship with the basal area of a fixed sample circle with the same central point and is thus used as an approximation to the basal area. The counting factor corresponds to the base area in m² added by a single tree falling into the angle count sample. The counting factors of 1 m², 2 m² and 4 m² are common.

Forest and Stand borders in the sample tree's and/or central point's vicinity are used for the reflection computation. This is a computational procedure, which reflects the sample tree's base areas on the aforementioned borders. Would the diameter of such a reflected tree  in combination with the refleæction's distance to the central point sufficeto fall into the ideal sample circle, then the preimage tree is counted twice in the sample."""@en ;
                  skos:prefLabel "Winkelzählprobe"@de ,
                                 "angle count sample"@en ,
                                 "muestra angular relascópica"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#Area
:Area rdf:type owl:Class ;
      rdfs:subClassOf :Quantity ;
      rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
      skos:definition "Area is the measure of a region's size on a surface."@en ;
      skos:note "In colloquial speach area can also have the same meaning as region. In the compound terms like 'forest area' and similar it has this meaning and these terms are established.  A compound term like 'forest region' would imply a different meaning in colloquial language than intended"@en ,
                "instances are related by ´qudt:hasUnit' to a ´qudt:Unit´, which ´qudt:hasQuantityKind´ ´qudt:Area´.  Usually this is  ´unit:HA´ or ´unit:AC´."@en ;
      skos:prefLabel "Fläche"@de ,
                     "area"@en ,
                     "área"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#Aspect
:Aspect rdf:type owl:Class ;
        rdfs:subClassOf :Quantity ;
        rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
        rdfs:seeAlso <https://en.wikipedia.org/wiki/Aspect_(geography)> ;
        skos:definition "the azimuth that a terrain surface faces"@en ;
        skos:note "Instances are related by ´qudt:hasUnit' to a ´qudt:Unit´, which ´qudt:hasQuantityKind´ ´qudt:Angle´. This usually is ´unit:DEG´ or ´unit:GON´"@en ;
        skos:prefLabel "Exposition"@de ,
                       "aspect"@en ,
                       "orientación"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#Azimuth
:Azimuth rdf:type owl:Class ;
         rdfs:subClassOf :Quantity ;
         rdfs:isDefinedBy "Wikipedia"^^xsd:string ;
         skos:altLabel "rumbo"@es ;
         skos:definition "The horizontal angle from the north cardinal direction in a local or observer-centric spherical coordinate system."@en ;
         skos:note "instances are related by ´qudt:hasUnit' to a ´qudt:Unit´, which ´qudt:hasQuantityKind´ ´qudt:Angle´. This usually is ´unit:DEG´ or ´unit:GON´"^^xsd:string ;
         skos:prefLabel "Azimuth"@de ,
                        "acimut"@es ,
                        "azimuth"@en .


###  https://www.easi.uni-bayreuth.de/crossnfi#BioticProcess
:BioticProcess rdf:type owl:Class ;
               rdfs:subClassOf :Process ;
               rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
               skos:definition "forest process in which the main actors are animals"@en ;
               skos:note "The main actors would for example be insects in an insect gradation or deer in browsing"@en ;
               skos:prefLabel "biotic process"@en ,
                              "biotischer Prozess"@de ,
                              "proceso biótico"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#BroadleavedTree
:BroadleavedTree rdf:type owl:Class ;
                 rdfs:subClassOf :Tree ;
                 rdfs:isDefinedBy "Wikipedia" ;
                 rdfs:label "Laubbaum"@de ,
                            "broadleaved tree"@en ;
                 skos:definition "A broad-leaved tree is any tree within the diverse botanical group of angiosperms that has flat leaves and produces seeds inside of fruits."@en .


###  https://www.easi.uni-bayreuth.de/crossnfi#Classification
:Classification rdf:type owl:Class ;
                rdfs:subClassOf :Quality ;
                dcterms:description """The classification is  dependent on some quality not directly measured, but assesed 
by the inventory team. Thus a classification can be interpreted as a quality for which the value space has been partitioned into several subsets of the correspondent value
space. The classification then notes in which subset the entity falls. As the classification fixes its own \"datatype\",  there is no need for metadata, so for the sake of conciseness the enitity is directly related to the classification instance.

A concrete classification is a subclass of  this class. The different subsets of the values space are modeled as instances and singleton subclasses of the classification class. This allows for grouping  several subclasses. 

An entity is related to a classification instance by a subproperty of the  the object property  `is_classified_as`.  The inverse property is called `is_classification_of`"""@en ;
                rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
                rdfs:label "Klassifizierung"@de ;
                skos:definition <https://www.easi.uni-bayreuth.de/crossnfi> ,
                                "A classification of an entity is a partition of some superclass into subclasses, which is not modeled as DL Concepts (OWL classes) but as a quality having the subclasses as a discrete value space."@en ;
                skos:prefLabel "clasificación"@es ,
                               "classification"@en .


###  https://www.easi.uni-bayreuth.de/crossnfi#Cluster
:Cluster rdf:type owl:Class ;
         rdfs:subClassOf :DataCollection ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :contains ;
                           owl:someValuesFrom :Plot
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :isPartOf ;
                           owl:someValuesFrom :NationalForestInventory
                         ] ;
         rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
         skos:altLabel "Plot (FIA)" ,
                       "Trakt (BWI)"@de ;
         skos:definition """set of plots which are located in the same neighbourhood, often arranged in a 
certain pattern."""@en ;
         skos:prefLabel "Cluster"@de ,
                        "acopiamiento"@es ,
                        "cluster"@en .


###  https://www.easi.uni-bayreuth.de/crossnfi#Conifer
:Conifer rdf:type owl:Class ;
         rdfs:subClassOf :Tree ;
         rdfs:isDefinedBy "Wikipedia, crossnfi"@en ;
         rdfs:label "Nadelbaum"@de ,
                    "conifer"@en ;
         skos:definition "Conifers are primarily perennial, woody trees, mostly evergreen and mostly with needle shaped leaves,  having a regular branching pattern, reproducing with male and female cones, usually on the same tree."@en .


###  https://www.easi.uni-bayreuth.de/crossnfi#DBH
:DBH rdf:type owl:Class ;
     rdfs:subClassOf :Quantity ;
     rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
     rdfs:seeAlso "Tomppo E et al 2010, National Forest Inventories: Pathways for Common Reporting, Appendix" ;
     skos:definition "The breast height of a tree is located at 1.3 m from the base point of the axis of the stem."@en ;
     skos:note """Instances are related by ´qudt:hasUnit' to a ´qudt:Unit´, which ´qudt:hasQuantityKind´ ´qudt:Length´. This usually is ´unit:M´, ´unit:CM´, ´unit:FT´, ´unit:YD´ or ´unit:IN´. 

Tomppo et al base point: On level terrain the base point is the point resulting from the intersection  of the stem axis and the ground surface. On sloped terrain and on inclined trees the identification of the base point requires the previous identification of an  an intersection point. This intersection point is the highest point on the cross sectional  area that results from the intersection of the ground surface with the stem. A line through the intersection point and perpendicular to the stem axis yields the base point in these  cases."""^^xsd:string ;
     skos:prefLabel "Brusthöhendurchmesser (BHD)"@de ,
                    "diameter at breast height (DBH)"@en ,
                    "diámetro a la altura de pecho (DAP)"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#DRC
:DRC rdf:type owl:Class ;
     rdfs:subClassOf :Quantity ;
     rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
     rdfs:seeAlso "USDA Forest Service, 2023, Forest Inventory and Analysis Glossary"^^xsd:string ;
     skos:definition "The diameter of a tree stem(s) measured at root collar or at the point nearest the ground line (whichever is higher) that represents the basal area of the tree, measured outside the bark."@en ;
     skos:note """Instances are related by ´qudt:hasUnit' to a ´qudt:Unit´, which ´qudt:hasQuantityKind´ ´qudt:Length´. This usually is ´unit:M´, ´unit:CM´, ´unit:FT´, ´unit:YD´ or ´unit:IN´. 

FIA:
For multi-stemmed trees, d.r.c. is calculated from an equation that incorporates the individual stem diameter measurements. The point of diameter measurement may vary for woodland trees with stems that are abnormally formed. With the exception of seedlings, woodland stems qualifying for measurement must be at least 1.0 inch in diameter or larger and at least 1.0 foot in length"""@en ;
     skos:prefLabel "Wurzelhalsdurchmesser"@en ,
                    "diameter at root collar"@en ,
                    "diámetro del cuello del raíz"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#DataCollection
:DataCollection rdf:type owl:Class ;
                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                  owl:onProperty :inYear ;
                                  owl:someValuesFrom xsd:integer
                                ] ;
                rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
                skos:broader "bfo : generally dependent continuant (31)"@en ;
                skos:definition "a collection of data"@en ;
                skos:prefLabel "Datensammlung"@de ,
                               "colleción de datos"@es ,
                               "data collection"@en .


###  https://www.easi.uni-bayreuth.de/crossnfi#Distance
:Distance rdf:type owl:Class ;
          rdfs:subClassOf :Quantity ;
          rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
          rdfs:seeAlso <https://en.wikipedia.org/wiki/Distance> ;
          skos:definition "The length of a straight line between two points"@en ;
          skos:note "instances are related by ´qudt:hasUnit' to a ´qudt:Unit´, which ´qudt:hasQuantityKind´ ´qudt:Length´. This usually is ´unit:M´, ´unit:CM´, ´unit:FT´, ´unit:YD´ or ´unit:IN´."^^xsd:string ;
          skos:prefLabel "Entfernung"@de ,
                         "distance"@en ,
                         "distancia"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#FixedCircleSample
:FixedCircleSample rdf:type owl:Class ;
                   rdfs:subClassOf :SampleOfTreesOfMinDiameter ;
                   rdfs:label "FixedCircleSample"@en .


###  https://www.easi.uni-bayreuth.de/crossnfi#ForestArea
:ForestArea rdf:type owl:Class ;
            rdfs:subClassOf :TotalArea ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty geo:sfWithin ;
                              owl:someValuesFrom :InventoryArea
                            ] ;
            rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ,
                             "FAO  Forest Resource Assement - Terms and Definitions"@en ;
            rdfs:seeAlso <https://www.fao.org/forest-resources-assessment/en/> ;
            skos:definition "Land spanning more than 0.5 hectares with trees higher than 5 meters and a canopy cover of more than 10 percent, or trees able to reach these thresholds in situ. It does not include land that is predominantly under agricultural or urban land use."@en ;
            skos:prefLabel "Waldfläche"@de ,
                           "area de bosque"@es ,
                           "forest area"@en .


###  https://www.easi.uni-bayreuth.de/crossnfi#ForestCommunity
:ForestCommunity rdf:type owl:Class ;
                 rdfs:subClassOf [ rdf:type owl:Restriction ;
                                   owl:onProperty geo:sfWithin ;
                                   owl:someValuesFrom :Region
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :inYear ;
                                   owl:someValuesFrom xsd:integer
                                 ] ;
                 rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
                 skos:broader "bfo : object aggregate (27)"@en ;
                 skos:definition "community of plants and animals living in a forest community, including their remains, defined by the area on which they are located."@en ;
                 skos:prefLabel "Wald-Lebensgemeinschaft"@de ,
                                "comunidad forestal"@es ,
                                "forest community"@en .


###  https://www.easi.uni-bayreuth.de/crossnfi#GrowthRegion
:GrowthRegion rdf:type owl:Class ;
              rdfs:subClassOf :TotalArea ;
              skos:prefLabel "Wuchsgebiet"@de ,
                             "growth region"@en .


