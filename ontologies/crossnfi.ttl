###  https://www.easi.uni-bayreuth.de/crossnfi#InventoryArea
:InventoryArea rdf:type owl:Class ;
               rdfs:subClassOf :TotalArea ;
               rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
               skos:definition "part of the earth surface in which a National Forest Inventory is applied. Most often coincides with the countrie's state area."@en ;
               skos:prefLabel "Inventurgebiet"@de ,
                              "inventory area"@en ,
                              "área de inventario"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#MapSubarea
:MapSubarea rdf:type owl:Class ;
            rdfs:subClassOf :TotalArea ;
            rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
            skos:definition "a subarea delineated in a map, most often a polygon or multipolygon. It has an area."@en ,
                            "subárea de una mapa"@es ;
            skos:prefLabel "Karten-Unterfläche"@de ,
