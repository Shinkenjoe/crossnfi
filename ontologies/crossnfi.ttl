                  rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
                  skos:definition "agricultural land"@en ,
                                  "land in agricultural use"@en ,
                                  "landwirtschaftliches Gelände"@de ,
                                  "tierra agrícola"@es ;
