@prefix : <https://www.easi.uni-bayreuth.de/crossnfi#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obda: <https://w3id.org/obda/vocabulary#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://www.easi.uni-bayreuth.de/crossnfi#> .

<https://www.easi.uni-bayreuth.de/crossnfi> rdf:type owl:Ontology ;
                                             owl:versionIRI <https://www.easi.uni-bayreuth.de/crossnfi_0.1> ;
                                             dcterms:description "An ontology to enable ODBA access for national forest inventories (NFI)"@en ;
                                             rdfs:label "crossnfi ontology 0.1"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#broader
skos:broader rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#closeMatch
skos:closeMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#note
skos:note rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty ;
               rdfs:subPropertyOf rdfs:label .


###  https://www.easi.uni-bayreuth.de/crossnfi#def
:def rdf:type owl:AnnotationProperty ;
     rdfs:label "def"@en .


###  https://www.easi.uni-bayreuth.de/crossnfi#pref
:pref rdf:type owl:AnnotationProperty ;
      rdfs:label "pref"@en .


#################################################################
#    Object Properties
#################################################################

###  http://www.opengis.net/ont/geosparql#hasGeometry
geo:hasGeometry rdf:type owl:ObjectProperty ;
                rdfs:domain geo:Feature ;
                rdfs:range geo:Geometry ;
                skos:definition "A spatial representation for a given Feature"@en ;
                skos:prefLabel "has Geometry"@en .


###  http://www.opengis.net/ont/geosparql#sfContains
geo:sfContains rdf:type owl:ObjectProperty ;
               owl:inverseOf geo:sfWithin ;
               skos:note "2d-spatial parthood (location) in the sense of Keet, 2025, Ontology Engineering"@en .


###  http://www.opengis.net/ont/geosparql#sfWithin
geo:sfWithin rdf:type owl:ObjectProperty ;
             skos:note "2d-spatial parthood (location) in the sense of Keet, 2025, Ontology Engineering"@en .


###  https://www.easi.uni-bayreuth.de/crossnfi#assignedByArea
:assignedByArea rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :assignedToStratum ;
                owl:inverseOf :containsPlotByArea ;
                rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
                skos:note "The plot gets assigned to the stratum by the map subarea it is contained in being assigned to the stratum area corresponding to this stratum"@en ;
                skos:prefLabel "asignado por área"@es ,
                               "assigned by area"@en ,
                               "zugewiesen durch Fläche"@de .


###  https://www.easi.uni-bayreuth.de/crossnfi#assignedByCondition
:assignedByCondition rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :assignedToStratum ;
                     owl:inverseOf :containsPlotByCondition ;
                     rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
                     skos:note "the plot is assigned to the stratum by the entities it desrcibes satisfying the conditions of the stratum"@en ;
                     skos:prefLabel "asignado por condición"@es ,
                                    "assigned by condition"@en ,
                                    "zugewiesen durch Bedingung"@de .


###  https://www.easi.uni-bayreuth.de/crossnfi#assignedToStratum
:assignedToStratum rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :isPartOf ;
                   owl:inverseOf :hasPlotAssigned ;
                   rdfs:domain :Stratum ;
                   rdfs:range :PlotDataset ;
                   rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
                   skos:prefLabel "asignado al estrato"@es ,
                                  "assigned to stratum"@en ,
                                  "zugewiesen zum Stratum"@de .


###  https://www.easi.uni-bayreuth.de/crossnfi#classifies
:classifies rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :isQualityOf ;
            owl:inverseOf :isClassifiedAs ;
            rdfs:domain :Classification ;
            rdfs:isDefinedBy "https://www.easi.uni-bayreuth.de/crossnfi" ;
            skos:definition "connects a classfication instance to an entity that is classified as this classfication instance"@en ;
            skos:prefLabel "clasifica"@es ,
                           "classifies"@en ,
                           "klassifiziert"@de .


###  https://www.easi.uni-bayreuth.de/crossnfi#collectedOnArea
:collectedOnArea rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf owl:topObjectProperty ;
                 owl:inverseOf :isPlaceForDataRecordingFor ;
                 rdfs:domain :DataCollection ;
                 rdfs:range :PlotArea ;
                 rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
                 skos:note """Domain: a sample or a collection of data like a national forest inventory, a cluster or a plot
Range:  a plot area"""@en ;
                 skos:prefLabel "aufgenommen auf"@de ,
                                "fichado en"@es ,
                                "recorded on"@en .


###  https://www.easi.uni-bayreuth.de/crossnfi#contains
:contains rdf:type owl:ObjectProperty ;
          rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
          skos:note "structural parthood in the sense of Keet, 2025 Ontology Engineering"@en ;
          skos:prefLabel "contains"@en ,
                         "contienes"@es ,
                         "enhält"@de .


###  https://www.easi.uni-bayreuth.de/crossnfi#containsPlotByArea
:containsPlotByArea rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :hasPlotAssigned ;
                    rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
                    skos:definition "the stratum contains a plot by the plot being located in a map subarea assigned to the stratum"@en ;
                    skos:prefLabel "contains plot by area"@en ,
                                   "contiene parcela por área"@es ,
                                   "enthält Plot durch Fläche"@de .


###  https://www.easi.uni-bayreuth.de/crossnfi#containsPlotByCondition
:containsPlotByCondition rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf :hasPlotAssigned ;
                         rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
                         skos:note "the stratum contains a plot by the plot satisfying its conditions"@en ;
                         skos:prefLabel "contains plot by condition"@en ,
                                        "contiene parcela por condición"@es ,
                                        "enthält Plot durch Bedingung"@de .


###  https://www.easi.uni-bayreuth.de/crossnfi#describedByPlot
:describedByPlot rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :desrcibedBy ;
                 owl:inverseOf :hasAsPlot ;
                 rdfs:range :PlotDataset ;
                 rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
                 skos:note """Domain: 
entities for which there is data to be found at a plot. These entities are samples (of trees or other entitities), area and its terrain, forest community, forest processes

Range: 
Plot"""@en ;
                 skos:prefLabel "beschriebenVonPlot"@de ,
                                "describedByPlot"@en ,
                                "describidoDeParcela"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#describes
:describes rdf:type owl:ObjectProperty ;
           rdfs:domain :DataCollection ;
           rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
           skos:definition "a data  collection like a Plot describes an entity if it has data about it"@en ;
           skos:prefLabel "beschreibt"@de ,
                          "describes"@en ,
                          "describes"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#desrcibedBy
:desrcibedBy rdf:type owl:ObjectProperty ;
             rdfs:range :DataCollection ;
             rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
             skos:definition "an enitiy is described by a ddata collection if the latter has data about the former"@en ;
             skos:prefLabel "beschrieben von"@de ,
                            "described by"@en ,
                            "describido de"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#hasAsPlot
:hasAsPlot rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :describes ;
           rdfs:domain :PlotDataset ;
           skos:note """Domain: 
Plot

Range: 
entities for which there is data to be found at a plot. These entities are samples (of trees or other entitities), area and its terrain, forest community, forest processes"""@en ;
           skos:prefLabel "beschreibtAlsPlot"@de ,
                          "describesAsPlot"@en ,
                          "describesComoParcela"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#hasAspect
:hasAspect rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :hasQuality ;
           rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
           skos:definition "relates a plot subarea to its aspect"@en ;
           skos:prefLabel "has aspect"@en ,
                          "hat Exposition"@de ,
                          "tiene orientación"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#hasAzimuth
:hasAzimuth rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :hasQuality ;
            rdfs:range :Azimuth ;
            rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
            skos:definition "relates a spatial entitiy to its azimuth in s planar coordinate system"@en ;
            skos:prefLabel "has azimuth"@en ,
                           "hat Azimuth"@de ,
                           "tiene azimuth"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#hasClusterSamplingStatus
:hasClusterSamplingStatus rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf :isClassifiedAs ;
                          owl:inverseOf :isClusterSamplingStatusOf ;
                          rdfs:domain :ClusterAreaSet ;
                          rdfs:range :ClusterAreaSetSamplingStatus ;
                          skos:definition "relates a plot main area to its plot sampling status classification" ;
                          skos:prefLabel "has cluster sampling status"@en ,
                                         "hat Cluster-Erfassungszustand"@de ,
                                         "tiene estado de muestreo de acopiamiento"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#hasCount
:hasCount rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf :hasQuality ;
          rdfs:domain :AngleCountSample ;
          rdfs:range :AngleCount ;
          rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
          skos:definition "relates an angle count sample to one of its angle counts"@en ;
          skos:prefLabel "has count"@en ,
                         "hat Anzahl"@de ,
                         "tiene conteo"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#hasDBH
:hasDBH rdf:type owl:ObjectProperty ;
        rdfs:subPropertyOf :hasQuality ;
        rdfs:domain :Tree ;
        rdfs:range :DBH ;
        rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
        skos:definition "relates a tree with its diameter at breast height"@en ;
        skos:prefLabel "has DBH"@en ,
                       "hat BHD"@de ,
                       "tiene DAP"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#hasDistance
:hasDistance rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :hasQuality ;
             rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
             skos:note "relates a spatial entity to its distance in a planar coordinate system"@en ;
             skos:prefLabel "has distance"@en ,
                            "hat Enternung"@de ,
                            "tiene distancia"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#hasHeight
:hasHeight rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :hasQuality ;
           rdfs:domain :Tree ;
           rdfs:range :TreeHeight ;
           rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
           skos:definition "relatzes a tree to its height"@en ;
           skos:prefLabel "hasHeight"@en ,
                          "hat Höhe"@de ,
                          "tiene altura"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#hasLandUse
:hasLandUse rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :isClassifiedAs ;
            rdfs:domain :NonForestPlotSubarea ;
            rdfs:range :LandUse ;
            rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
            skos:definition "relates a non-forest subplot area to the classification instance corresponding to its land use"@en ;
            skos:prefLabel "has land use"@en ,
                           "hat Landnutzung"@de ,
                           "tiene uso del suelo"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#hasMinDBH
:hasMinDBH rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :hasQuality ;
           rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
           skos:definition "relates a sample of Trees above"@en ;
           skos:prefLabel "has minimum DBH"@en ,
                          "hat Mindest-BHD"@de ,
                          "tiene DAP  mínima"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#hasOriginallyScheduled
:hasOriginallyScheduled rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf geo:hasGeometry ;
                        rdfs:domain :InventoryScheme ;
                        rdfs:range :Position ;
                        skos:definition "hat ursprünglich geplant"@de ,
                                        "the position that was initially assigned to a template cluster or template plot by the NFI procedure (grid or random choice)"@en ,
                                        "tiene provista originalmente"@es ;
                        skos:prefLabel "has originally scheduled"@en .


###  https://www.easi.uni-bayreuth.de/crossnfi#hasOwnerGroup
:hasOwnerGroup rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :isClassifiedAs ;
               owl:inverseOf :isOwnerGroupOf ;
               rdfs:domain :PlotSubArea ;
               rdfs:range :OwnerGroup ;
               rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
               skos:definition "relates a plot subabrea to its owner group classification"@en ;
               skos:prefLabel "has owner group"@en ,
                              "hat Eigentümergruppe"@de ,
                              "tiene grupo de propietario"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#hasPlotAssigned
:hasPlotAssigned rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :contains ;
                 rdfs:domain :Stratum ;
                 rdfs:range :PlotDataset ;
                 rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
                 skos:definition "relates a stratum to one of its plots" ;
                 skos:prefLabel "has plot assigned"@en ,
                                "hat Plot zugewiesen"@de ,
                                "tiene plot asignado"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#hasPlotSamplingStatus
:hasPlotSamplingStatus rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf :isClassifiedAs ;
                       owl:inverseOf :isPlotSamplingStatusOf ;
                       rdfs:domain :PlotMainArea ;
                       rdfs:range :PlotMainAreaSamplingStatus ;
                       rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
                       skos:definition "relates a plot main area to its plot sampling status classification"@en ;
                       skos:prefLabel "has plot sampling status"@en ,
                                      "hat Plot-Erfassungszustand"@de ,
                                      "tiene estado de muestreo de parcela"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#hasQuality
:hasQuality rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf owl:topObjectProperty ;
            owl:inverseOf :isQualityOf ;
            rdfs:range :Quality ;
            rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
            skos:definition "relates an entity to one of its qualities"@en ;
            skos:prefLabel "has quality"@en ,
                           "hat Qualität"@de ,
                           "tiene calidad"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#hasReferencePosition
:hasReferencePosition rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf geo:hasGeometry ;
                      rdfs:domain geo:Feature ;
                      rdfs:range :Position ;
                      skos:definition "has reference position"@en ,
                                      "hat Referenzposition"@de ,
                                      "relates a feature to its reference position."@en ,
                                      "tiene posición de referencia"@es ;
                      skos:note """For many features like most plot main areas or sample areas this is the central point of a circle, for other features like the German BWI 's cluster area set it is the northwest
plot main area's reference position."""@en .


###  https://www.easi.uni-bayreuth.de/crossnfi#hasScheduled
:hasScheduled rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf geo:hasGeometry ;
              rdfs:domain :InventoryScheme ;
              rdfs:range :Position ;
              skos:definition "before the first survey a template cluster or template point  has scheduled the same position that it has originally scheduled, after that it is the position of the last survey implementation"@en ;
              skos:prefLabel "has scheduled"@en ,
                             "hat geplant"@de ,
                             "tiene provista"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#hasSlope
:hasSlope rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf :hasQuality ;
          rdfs:domain :PlotSubArea ;
          rdfs:range :Slope ;
          rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
          skos:definition "relates a plot subarea (terrain) to its slope" ;
          skos:prefLabel "has slope"@en ,
                         "hat Neigung"@de ,
                         "tiene pendiente"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#hasStandSizeClass
:hasStandSizeClass rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :isClassifiedAs ;
                   rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
                   skos:definition "relates a forest community to ist classfication instance of stand size"@en ;
                   skos:prefLabel "has stand size class"@en ,
                                  "hat Dimensionsklasse"@en ,
                                  "tiene estado de diámetro"@es .


###  https://www.easi.uni-bayreuth.de/crossnfi#implements
:implements rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf owl:topObjectProperty ;
            owl:inverseOf :isImplementedBy ;
            rdfs:domain geo:Feature ;
            rdfs:range :InventoryScheme ;
            skos:definition """a cluster area  set  implements a template cluster , if its reference position is sufficiently close to the template cluster's  scheduled position at the beginning of the cluster area set's lifetime. 

Likewise a plot main area implements a template plot, if its central position is located sufficiently close to the template plot's scheduled position at the beginning of the template plot's lifetime"""@en ;
            skos:prefLabel "implementa"@es ,
                           "implementiert"@de ,
                           "implements"@en .


###  https://www.easi.uni-bayreuth.de/crossnfi#impliesByPattern
:impliesByPattern rdf:type owl:ObjectProperty ;
                  owl:inverseOf :isImpliedByPatternBy ;
                  rdfs:domain :TemplateCluster ;
                  rdfs:range :TemplatePlot ;
                  skos:definition "a template cluster's originally scheduled location dictates its template points' originally scheduled location by a spatial pattern"@en ;
                  skos:prefLabel "bestimmt durch Muster"@de ,
                                 "implica por molde"@es ,
                                 "implies by pattern"@en .


###  https://www.easi.uni-bayreuth.de/crossnfi#isClassifiedAs
:isClassifiedAs rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :hasQuality ;
                rdfs:range :Classification ;
                rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
                skos:definition "connects  an entity to one of its classifications"@en ;
                skos:prefLabel "es clasificado como"@es ,
                               "is classified as"@en ,
                               "ist klassifiziert als"@de .


###  https://www.easi.uni-bayreuth.de/crossnfi#isClusterSamplingStatusOf
:isClusterSamplingStatusOf rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf :classifies ;
                           rdfs:domain :ClusterAreaSetSamplingStatus ;
                           rdfs:range :ClusterAreaSet ;
                           skos:definition "relates a cluster sampling status classification to a cluster area set with the corresponding sampling status"@en ;
                           skos:prefLabel "es estado de muestreo de acopiamiento de"@es ,
                                          "is cluster sampling status of"@en ,
                                          "ist Cluster-Erfassungszustand vor"@de .


###  https://www.easi.uni-bayreuth.de/crossnfi#isImplementedBy
:isImplementedBy rdf:type owl:ObjectProperty ;
                 rdfs:domain :InventoryScheme ;
                 rdfs:range geo:Feature ;
                 skos:definition """a template cluster is implemented by a cluster area set  , if  the cluster area set's reference position is sufficiently close to the template cluster's  scheduled position at the beginning of the cluster area set's lifetime. 

Likewise a template plot is implemented by a plot main area, if the plot main area's central position is located sufficiently close to the template plot's scheduled position at the beginning of the template plot's lifetime"""@en ;
                 skos:prefLabel "es implementado por"@es ,
                                "is implemented by"@en ,
                                "wird implementiert von"@de .


###  https://www.easi.uni-bayreuth.de/crossnfi#isImpliedByPatternBy
:isImpliedByPatternBy rdf:type owl:ObjectProperty ;
                      rdfs:domain :TemplatePlot ;
                      rdfs:range :TemplateCluster ;
                      skos:definition "a template point's originally scheduled location depends on the originally scheduled location of its cluster"@en ;
                      skos:prefLabel "es implicado por molde por"@es ,
                                     "is implied by pattern by"@en ,
                                     "ist per Muster bestimmt durch"@de .


###  https://www.easi.uni-bayreuth.de/crossnfi#isLandUseOf
:isLandUseOf rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :classifies ;
             rdfs:domain :LandUse ;
             rdfs:range :NonForestPlotSubarea ;
             rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
             skos:definition "relates a land use classification instance to a non-forest subplot area with a corresponding land use"@en ;
             skos:prefLabel "es uso del suelo de"@es ,
                            "is land use of"@en ,
                            "ist Landnutzung von"@de .


###  https://www.easi.uni-bayreuth.de/crossnfi#isOwnerGroupOf
:isOwnerGroupOf rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :classifies ;
                rdfs:domain :OwnerGroup ;
                rdfs:range :PlotSubArea ;
                rdfs:isDefinedBy "https://www.easi.uni-bayreuth.de/crossnfi" ;
                skos:definition "connects a owner classification instance to a plot subarea which is owned by a member of the corresponding owner group"@en ;
                skos:prefLabel "es grupo de propietario de"@es ,
                               "is owner group of"@en ,
                               "ist Eigentümergruppe von"@en .


###  https://www.easi.uni-bayreuth.de/crossnfi#isPartOf
:isPartOf rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf owl:topObjectProperty ;
          skos:note "structural parthood in the sense of Keet, 2025, Ontology Engineering"@en ;
          skos:prefLabel "es parte de"@es ,
                         "is part of"@en ,
                         "ist Teil von"@de .


###  https://www.easi.uni-bayreuth.de/crossnfi#isPlaceForDataRecordingFor
:isPlaceForDataRecordingFor rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf owl:topObjectProperty ;
                            rdfs:domain :PlotArea ;
                            rdfs:range :DataCollection ;
                            rdfs:isDefinedBy <https://www.easi.uni-bayreuth.de/crossnfi> ;
                            skos:note """Domain: plot area
Range: a sample or data collections like a national forest inventory, a cluster or a plot"""@en ;
                            skos:prefLabel "es lugar de registro de datos de"@es ,
                                           "is place of data recording for"@en ,
                                           "ist Ort der Datenaufnahme von"@de .


###  https://www.easi.uni-bayreuth.de/crossnfi#isPlotSamplingStatusOf
:isPlotSamplingStatusOf rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf :classifies ;
                        rdfs:domain :PlotMainAreaSamplingStatus ;
                        rdfs:range :PlotMainArea ;
                        rdfs:isDefinedBy "https://www.easi.uni-bayreuth.de/crossnfi" ;
                        skos:definition "relates a plot sampling status classification to a plot main area with the corresponding sampling status"@en ;
                        skos:prefLabel "es estado de muestreo de parcela de"@es ,
                                       "is  plot sampling status of"@en ,
                                       "ist Plot-Erfassungszustand von"@de .


