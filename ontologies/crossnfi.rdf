    <!-- http://qudt.org/schema/qudt/Quantity -->

    <owl:Class rdf:about="http://qudt.org/schema/qudt/Quantity">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#Quality"/>
        <dcterms:description xml:lang="en">&lt;p&gt;A &lt;b&gt;Quantity&lt;/b&gt; is the measurement of an observable property of a particular object, event, or physical system. 
  A quantity is always associated with the context of measurement (i.e. the thing measured, the measured value, the accuracy of measurement, etc.) whereas the 
  underlying &lt;b&gt;quantity kind&lt;/b&gt; is independent of any particular measurement. Thus, length is a quantity kind while the height of a rocket is a specific 
  quantity of length; its magnitude that may be expressed in meters, feet, inches, etc. Examples of physical quantities include physical constants, such as 
  the speed of light in a vacuum, Planck&apos;s constant, the electric permittivity of free space, and the fine structure constant. &lt;/p&gt;
&lt;p&gt;In other words, quantities are quantifiable aspects of the world, such as the duration of a movie, the distance between two points, 
velocity of a car, the pressure of the atmosphere, and a person&apos;s weight; and units are used to describe their numerical measure.&lt;/p&gt; 
&lt;p&gt;Many &lt;b&gt;quantity kinds&lt;/b&gt; are related to each other by various physical laws, and as a result, the associated units of some quantity 
kinds can be expressed as products (or ratios) of powers of other quantity kinds (e.g., momentum is mass times velocity and velocity is defined as distance 
divided by time). In this way, some quantities can be calculated from other measured quantities using their associations to the quantity kinds in these 
expressions. These quantity kind relationships are also discussed in dimensional analysis. Those that cannot be so expressed can be regarded 
as &quot;fundamental&quot; in this sense.&lt;/p&gt;
&lt;p&gt;A quantity is distinguished from a &quot;quantity kind&quot; in that the former carries a value and the latter is a type specifier.
&lt;/p&gt;</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/3.5.0/schema/shacl/qudt"/>
        <rdfs:label xml:lang="en">Quantity</rdfs:label>
        <rdfs:label xml:lang="de">Quantität</rdfs:label>
        <rdfs:label xml:lang="es">cantidad</rdfs:label>
        <skos:definition xml:lang="en">A quality that refers to a numerical value by a subproperty of `qudt:value` and its metadata like physical units by `qudt:hasUnit`</skos:definition>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#AbioticProcess -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#AbioticProcess">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#Process"/>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:definition xml:lang="en">a process where the main actor is abiotic, most often a metereoloical force or condition that is deviating from the normal condition or force.</skos:definition>
        <skos:definition xml:lang="es">proceso abiótico</skos:definition>
        <skos:prefLabel xml:lang="es">abiotic process</skos:prefLabel>
        <skos:prefLabel xml:lang="de">abiotischer Prozess</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#Area -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#Area">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Quantity"/>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <rdfs:isDefinedBy xml:lang="en">Area is the measure of a region&apos;s size on a surface.</rdfs:isDefinedBy>
        <skos:note xml:lang="en">In colloquial speach area can also have the same meaning as region. In the compound terms like &apos;forest area&apos; and similar it has this meaning and these terms are established.  A compound term like &apos;forest region&apos; would imply a different meaning in colloquial language than intended</skos:note>
        <skos:note xml:lang="en">instances are related to by &apos;qudt:hasQuantityKind&apos;  to `qudt:Area`</skos:note>
        <skos:prefLabel xml:lang="de">Fläche</skos:prefLabel>
        <skos:prefLabel xml:lang="en">area</skos:prefLabel>
        <skos:prefLabel xml:lang="es">área</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#BioticProcess -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#BioticProcess">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#Process"/>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:definition xml:lang="en">forest process in which the main actors are animals</skos:definition>
        <skos:note xml:lang="en">The main actors would for example be insects in an insect gradation or deer in browsing</skos:note>
        <skos:prefLabel xml:lang="en">biotic process</skos:prefLabel>
        <skos:prefLabel xml:lang="de">biotischer Prozess</skos:prefLabel>
        <skos:prefLabel xml:lang="es">proceso biótico</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#BroadleavedTree -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#BroadleavedTree">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#Tree"/>
        <rdfs:isDefinedBy>Wikipedia</rdfs:isDefinedBy>
        <rdfs:label xml:lang="de">Laubbaum</rdfs:label>
        <rdfs:label xml:lang="en">broadleaved tree</rdfs:label>
        <skos:definition xml:lang="en">A broad-leaved tree is any tree within the diverse botanical group of angiosperms that has flat leaves and produces seeds inside of fruits.</skos:definition>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#Classification -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#Classification">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#Quality"/>
        <dcterms:description xml:lang="en">The classification is  dependent on some quality not directly measured, but assesed 
by the inventory team. Thus a classification can be interpreted as a quality for which the value space has been partitioned into several subsets of the correspondent value
space. The classification then notes in which subset the entity falls. As the classification fixes its own &quot;datatype&quot;,  there is no need for metadata, so for the sake of conciseness the enitity is directly related to the classification instance.

A concrete classification is a subclass of  this class. The different subsets of the values space are modeled as instances and singleton subclasses of the classification class. This allows for grouping  several subclasses. 

An entity is related to a classification instance by a subproperty of the  the object property  `is_classified_as`.  The inverse property is called `is_classification_of`</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <rdfs:label xml:lang="de">Klassifizierung</rdfs:label>
        <skos:definition rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:definition xml:lang="en">A classification of an entity is a partition of some superclass into subclasses, which is not modeled as DL Concepts (OWL classes) but as a quality having the subclasses as a discrete value space.</skos:definition>
        <skos:prefLabel xml:lang="es">clasificación</skos:prefLabel>
        <skos:prefLabel xml:lang="en">classification</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#Cluster -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#Cluster">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#DataCollection"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#contains"/>
                <owl:someValuesFrom rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#Plot"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#isPartOf"/>
                <owl:someValuesFrom rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#NationalForestInventory"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:altLabel xml:lang="de">Trakt (BWI)</skos:altLabel>
        <skos:altLabel>Plot (FIA)</skos:altLabel>
        <skos:definition xml:lang="en">set of plots which are located in the same neighbourhood, often arranged in a 
certain pattern.</skos:definition>
        <skos:prefLabel xml:lang="de">Cluster</skos:prefLabel>
        <skos:prefLabel xml:lang="es">acopiamiento</skos:prefLabel>
        <skos:prefLabel xml:lang="en">cluster</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#Conifer -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#Conifer">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#Tree"/>
        <rdfs:isDefinedBy xml:lang="en">Wikipedia, crossnfi</rdfs:isDefinedBy>
        <rdfs:label xml:lang="de">Nadelbaum</rdfs:label>
        <rdfs:label xml:lang="en">conifer</rdfs:label>
        <skos:definition xml:lang="en">Conifers are primarily perennial, woody trees, mostly evergreen and mostly with needle shaped leaves,  having a regular branching pattern, reproducing with male and female cones, usually on the same tree.</skos:definition>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#DBH -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#DBH">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Quantity"/>
        <rdfs:isDefinedBy>Tomppo E et al 2010, National Forest Inventories: Pathways for Common Reporting, Appendix</rdfs:isDefinedBy>
        <skos:definition xml:lang="en">The breast height of a tree is located at 1.3 m from the base point of the axis of the stem.</skos:definition>
        <skos:note xml:lang="en">An instance is related by `qudt:hasQuantityKind` to `qudt:Length`

Tomppo et al base point: On level terrain the base point is the point resulting from the intersection  of the stem axis and the ground surface. On sloped terrain and on inclined trees the identification of the base point requires the previous identification of an  an intersection point. This intersection point is the highest point on the cross sectional  area that results from the intersection of the ground surface with the stem. A line through the intersection point and perpendicular to the stem axis yields the base point in these  cases. 

FIA definition:  The diameter of a tree bole/stem (trunk) measured at breast height (4.5 feet = 1.37 m) above ground, measured outside the bark. The point of diameter measurement may vary for abnormally  formed trees.</skos:note>
        <skos:prefLabel xml:lang="de">Brusthöhendurchmesser</skos:prefLabel>
        <skos:prefLabel xml:lang="en">diameter at breast height</skos:prefLabel>
        <skos:prefLabel xml:lang="es">diámetro a la altura de pecho</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#DataCollection -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#DataCollection">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#inYear"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:broader xml:lang="en">bfo : generally dependent continuant (31)</skos:broader>
        <skos:definition xml:lang="en">a collection of data</skos:definition>
        <skos:prefLabel xml:lang="de">Datensammlung</skos:prefLabel>
        <skos:prefLabel xml:lang="es">colleción de datos</skos:prefLabel>
        <skos:prefLabel xml:lang="en">data collection</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#ForestArea -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#ForestArea">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#TotalArea"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#sfWithin"/>
                <owl:someValuesFrom rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#InventoryArea"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">FAO  Forest Resource Assement - Terms and Definitions</rdfs:isDefinedBy>
        <rdfs:seeAlso rdf:resource="https://www.fao.org/forest-resources-assessment/en/"/>
        <skos:definition xml:lang="en">Land spanning more than 0.5 hectares with trees higher than 5 meters and a canopy cover of more than 10 percent, or trees able to reach these thresholds in situ. It does not include land that is predominantly under agricultural or urban land use.</skos:definition>
        <skos:prefLabel xml:lang="de">Waldfläche</skos:prefLabel>
        <skos:prefLabel xml:lang="es">area de bosque</skos:prefLabel>
        <skos:prefLabel xml:lang="en">forest area</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#ForestCommunity -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#ForestCommunity">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#sfWithin"/>
                <owl:someValuesFrom rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#Region"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#inYear"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:broader xml:lang="en">bfo : object aggregate (27)</skos:broader>
        <skos:definition xml:lang="en">community of plants and animals living in a forest community, including their remains, defined by the area on which they are located.</skos:definition>
        <skos:prefLabel xml:lang="de">Wald-Lebensgemeinschaft</skos:prefLabel>
        <skos:prefLabel xml:lang="es">comunidad forestal</skos:prefLabel>
        <skos:prefLabel xml:lang="en">forest community</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#Herb -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#Herb">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#Plant"/>
        <rdfs:isDefinedBy xml:lang="en">Wikipedia</rdfs:isDefinedBy>
        <skos:prefLabel xml:lang="en">herbaceous plant</skos:prefLabel>
        <skos:prefLabel xml:lang="es">hierba</skos:prefLabel>
        <skos:prefLabel xml:lang="de">krautige Pflanze</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#HumanActivity -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#HumanActivity">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#Process"/>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:definition xml:lang="en">a process where the main actors are human</skos:definition>
        <skos:prefLabel xml:lang="es">actuación humana</skos:prefLabel>
        <skos:prefLabel xml:lang="en">human activity</skos:prefLabel>
        <skos:prefLabel xml:lang="de">menschliche Aktitvität</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#InventoryArea -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#InventoryArea">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#TotalArea"/>
        <skos:definition xml:lang="en">part of the earth surface in which a National Forest Inventory is applied. Most often coincides with the countrie&apos;s state area.</skos:definition>
        <skos:prefLabel xml:lang="de">Inventurgebiet</skos:prefLabel>
        <skos:prefLabel xml:lang="en">inventory area</skos:prefLabel>
        <skos:prefLabel xml:lang="es">área de inventario</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#MapSubarea -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#MapSubarea">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#TotalArea"/>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:definition xml:lang="en">a subarea delineated in a map, most often a polygon or multipolygon. It has an area.</skos:definition>
        <skos:definition xml:lang="es">subárea de una mapa</skos:definition>
        <skos:prefLabel xml:lang="de">Karten-Unterfläche</skos:prefLabel>
        <skos:prefLabel xml:lang="en">map subarea</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#NationalForestInventory -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#NationalForestInventory">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#DataCollection"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#collectedOnArea"/>
                <owl:someValuesFrom rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#InventoryArea"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#contains"/>
                <owl:someValuesFrom rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#Plot"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:broader xml:lang="en">bfo : generally dependent continuant (31)</skos:broader>
        <skos:definition xml:lang="en">A collection of data and metadata of measurements in forests which are collected in a  a National Forest Inventory Project.</skos:definition>
        <skos:prefLabel xml:lang="en">National Forest Inventory</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Nationale Forstinventur</skos:prefLabel>
        <skos:prefLabel xml:lang="es">inventario forestal nacional</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#NonForestArea -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#NonForestArea">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#TotalArea"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#sfWithin"/>
                <owl:someValuesFrom rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#InventoryArea"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition xml:lang="en">area in an inventory area that is not forest area</skos:definition>
        <skos:prefLabel xml:lang="de">Nichtwaldfläche</skos:prefLabel>
        <skos:prefLabel xml:lang="en">non forest area</skos:prefLabel>
        <skos:prefLabel xml:lang="es">área de no bosque</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#NonForestPlotSubarea -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#NonForestPlotSubarea">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#PlotInventoryArea"/>
        <skos:definition xml:lang="en">a plot subarea which is not located in forest area</skos:definition>
        <skos:prefLabel xml:lang="de">Nichtwald-Plotunterfläche</skos:prefLabel>
        <skos:prefLabel xml:lang="en">non forest plot subarea</skos:prefLabel>
        <skos:prefLabel xml:lang="es">subárea de parcela de no bosque</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#NonInventoryArea -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#NonInventoryArea">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#TotalArea"/>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:prefLabel xml:lang="de">Nichtinventurgebiet</skos:prefLabel>
        <skos:prefLabel xml:lang="en">non-inventory area</skos:prefLabel>
        <skos:prefLabel xml:lang="en">part of the earth surface which is not inventory area for a certain NFI</skos:prefLabel>
        <skos:prefLabel xml:lang="es">área de non-inventario</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#Plant -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#Plant">
        <rdfs:isDefinedBy xml:lang="en">Wikipedia</rdfs:isDefinedBy>
        <skos:broader>bfo : object (30)</skos:broader>
        <skos:definition xml:lang="en">Plants are the eukaryotic organisms that constitute the kingdom Plantae.</skos:definition>
        <skos:prefLabel xml:lang="de">Pflanze</skos:prefLabel>
        <skos:prefLabel xml:lang="en">plant</skos:prefLabel>
        <skos:prefLabel xml:lang="es">planta</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#Plot -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#Plot">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#DataCollection"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#isPartOf"/>
                <owl:someValuesFrom rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#NationalForestInventory"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:description xml:lang="en">The entities that a plot refers to usually are the plot area and the terrain it encompasses, the forest community, human activities taking place on the plot terrain, samples of trees and  deadwood taken on the plot area.</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:altLabel xml:lang="de">Traktecke (BWI)</skos:altLabel>
        <skos:altLabel xml:lang="en">subplot (FIA)</skos:altLabel>
        <skos:definition xml:lang="en">A collection of data recorded in a National Forest Inventory of entities that are located in the neighbourhood of a reference location. Refers to this location by `hasCentralPoint`</skos:definition>
        <skos:prefLabel xml:lang="de">Plot</skos:prefLabel>
        <skos:prefLabel xml:lang="es">parcela</skos:prefLabel>
        <skos:prefLabel xml:lang="en">plot</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#PlotAbioticProcess -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#PlotAbioticProcess">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#AbioticProcess"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#takesPlaceIn"/>
                <owl:someValuesFrom rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#PlotInventoryArea"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:definition xml:lang="en">abiotic process which takes place in a plot subarea</skos:definition>
        <skos:prefLabel xml:lang="en">abiotic process on a plot subarea</skos:prefLabel>
        <skos:prefLabel xml:lang="de">abiotischer Prozess auf einer Plotunterfläche</skos:prefLabel>
        <skos:prefLabel xml:lang="es">proceso abiótico en a subárea de parcela</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#PlotArea -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#PlotArea">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#Region"/>
        <dcterms:description xml:lang="en">In the population-sample pattern applied for areas this is a sample.</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:broader xml:lang="en">bfo : two-dimensional spatial region (9)</skos:broader>
        <skos:definition xml:lang="en">The part of the earth surface that is used for classifications and measurements belonging to a plot of a National Forest Inventory</skos:definition>
        <skos:prefLabel xml:lang="de">Plotfläche</skos:prefLabel>
        <skos:prefLabel xml:lang="en">plot area</skos:prefLabel>
        <skos:prefLabel xml:lang="es">área de  parcela</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#PlotBioticProcess -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#PlotBioticProcess">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#BioticProcess"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#takesPlaceIn"/>
                <owl:someValuesFrom rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#PlotInventoryArea"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:definition xml:lang="en">biotic process taking place on a inventory plot subarea</skos:definition>
        <skos:prefLabel xml:lang="en">biotic process on a plot subarea</skos:prefLabel>
        <skos:prefLabel xml:lang="de">biotischer Prozess auf einer Plotunterfläche</skos:prefLabel>
        <skos:prefLabel xml:lang="es">proceso biótico en una subárea de parcela</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#PlotDensityArea -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#PlotDensityArea">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#TotalArea"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#sfWithin"/>
                <owl:someValuesFrom rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#InventoryArea"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition xml:lang="en">An area where plots or clusters are spatially arranged by an algorithm resulting in a certain density of plots and clusters.</skos:definition>
        <skos:note xml:lang="en">a set of areas with uniform plot entities partitions an inventory area</skos:note>
        <skos:prefLabel xml:lang="de">Gebiet mit einheitlicher Stichprobendichte</skos:prefLabel>
        <skos:prefLabel xml:lang="en">area of uniform plot density</skos:prefLabel>
        <skos:prefLabel xml:lang="es">área de densidad de parcela uniforma</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#PlotForestArea -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#PlotForestArea">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#PlotInventoryArea"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#sfWithin"/>
                <owl:someValuesFrom rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#ForestArea"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition xml:lang="en">plot area which is situated in a forest area</skos:definition>
        <skos:prefLabel xml:lang="de">Wald-Plotunterfläche</skos:prefLabel>
        <skos:prefLabel xml:lang="en">forest plot subarea</skos:prefLabel>
        <skos:prefLabel xml:lang="es">área de parcela en bosque</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#PlotForestCommunity -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#PlotForestCommunity">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#ForestCommunity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#sfWithin"/>
                <owl:someValuesFrom rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#PlotForestArea"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition xml:lang="en">the community of plants and animals found on  a forest plot subarea</skos:definition>
        <skos:prefLabel xml:lang="de">Wald-Lebensgemeinschaft einer Plotunterfläche</skos:prefLabel>
        <skos:prefLabel xml:lang="es">comunidad forestal de un subárea de parcela</skos:prefLabel>
        <skos:prefLabel xml:lang="en">forest commmunity of a subplot area</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#PlotGreaterArea -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#PlotGreaterArea">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#PlotArea"/>
        <dcterms:description xml:lang="en">This class is intended not to be populated with instances. 

Any plot subarea is contained in a single plot greater area, which will not be found in 
the data and is kept here just for conceptually clarity. 

For some classifications or even measurements a wider area then the dilineated one is used, eg for classifying the macroterrain one needs to consider an area that is well beyond any defined limits. Else how could one differentiate between upper slope and lower slope.  For some classifications a concrete area is given, eg the BWI states that forest type has to be assesed in a 25m radius around the plot central point. 

When these classifications are taken from entities found in the greater plot area, they are copied over to the plot subareas. That is each contained plot subarea or entity related to one of the subplot areas gets classified. 

As an example take the above assesment of  forest type in BWI where there are 2 stands delineated.  The  classification is on the Forest Community, which is located in the plot greater area and thus in both plot-subareas. Thus each plot subarea refers to the same forest type entity and its classification, but the properties are settled in the plot subareas. There is not an instance of the plot greater area, so it cannot be refered to.</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:definition xml:lang="en">Area around the plot that is not delineated, but still used for assessing classifications.</skos:definition>
        <skos:prefLabel xml:lang="de">erweiterte Plotfläche</skos:prefLabel>
        <skos:prefLabel xml:lang="en">plot greater area</skos:prefLabel>
        <skos:prefLabel xml:lang="es">área ampliada de parcela</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#PlotHumanActivity -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#PlotHumanActivity">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#HumanActivity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#takesPlaceIn"/>
                <owl:someValuesFrom rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#PlotInventoryArea"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:definition xml:lang="en">human activity that takes place on an inventory plot subarea</skos:definition>
        <skos:prefLabel xml:lang="es">actividad humana en una subárea de parcela</skos:prefLabel>
        <skos:prefLabel xml:lang="en">human activity on a plot subarea</skos:prefLabel>
        <skos:prefLabel xml:lang="de">menschliche Aktivität auf einer Plotunterfläche</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#PlotInventoryArea -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#PlotInventoryArea">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#PlotSubArea"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#sfWithin"/>
                <owl:someValuesFrom rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#InventoryArea"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#sfWithin"/>
                <owl:someValuesFrom rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#PlotDensityArea"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:definition xml:lang="en">plot subarea that is contained in an inventory area</skos:definition>
        <skos:note xml:lang="en">Since the Inventory Area is partitioned into areas of uniform plot density, every inventory plot subarae must also be in a  area of uniform plot denisity</skos:note>
        <skos:prefLabel xml:lang="de">Inventur-Plotunterfläche</skos:prefLabel>
        <skos:prefLabel xml:lang="en">inventory plot subarea</skos:prefLabel>
        <skos:prefLabel xml:lang="es">área de parcela de inventario</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#PlotNonInventoryArea -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#PlotNonInventoryArea">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#PlotSubArea"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#sfWithin"/>
                <owl:someValuesFrom rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#NonInventoryArea"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition xml:lang="en">plot subarea that either is not in an inventory area, or which is in a different area of uniform plot density than  the rest of its cluster and thus not registered</skos:definition>
        <skos:prefLabel xml:lang="de">Nichtinventur-Plotunterfläche</skos:prefLabel>
        <skos:prefLabel xml:lang="es">area de parcela de noninventario</skos:prefLabel>
        <skos:prefLabel xml:lang="en">non-inventory plot subarea</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#PlotSubArea -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#PlotSubArea">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#PlotArea"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#describedByPlot"/>
                <owl:someValuesFrom rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#Plot"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:altLabel xml:lang="en">condition class (FIA)</skos:altLabel>
        <skos:definition xml:lang="en">A part of the plot greater area for which boundaries are established to other parts and which is differentiated from these other parts by criteria specific to the National Forest Inventory, most often at least based on a Forest / Nonforest distinction.</skos:definition>
        <skos:note xml:lang="en">Classifications of Terrain, Area, Forest Community and Human Activity are spatially applied at this level, which means either the area directly or an entity located in it is classified. 

Classifications which are true for all the plot area this plot subarea is part of are repeated for every plot subarea of the parent plot area. 

Classifications of terrain and legal status are applied directly to the area with their 
different ontological entities being short-circuited into this class for the sake of brevity. 

Possible boundaries are refered to by `geo:hasGeometry`

If a National Forest Inventory divides a plot greater area into subareas that have a finer type system than crossnfi, then different plot subareas of same crossnfi-class are created, with differing classifications in the differentiation quality. Eg FIA divides its condition classes also along owner group, while crossnfi only knows Forest and Non-Forest. Thus the plot will have several subplot areas of type Forest, which have differing owner group classifications.

FIA is the only NFI of the three which constructs these expliicitly. IFN (Inventario Forestal Nacional) moves the plot if sample areas would fall into Non-Forest or a land use different to the land use of the plot central point and thus avoids the problem. BWI notes boundaries between Forest and Non-Forest and Stands, but uses these boundaries for a mirroring algorithm for its angle count sample, so that the non-forest subplot areas are included into the forest inventory only implicitly by  extending the measurements by fictious entities creating an imaginary world without the forest or stand border.</skos:note>
        <skos:prefLabel xml:lang="de">Plotunterfläche</skos:prefLabel>
        <skos:prefLabel xml:lang="en">plot subarea</skos:prefLabel>
        <skos:prefLabel xml:lang="es">subarea de parcela</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#Process -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#Process">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#takesPlaceIn"/>
                <owl:someValuesFrom rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#Region"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:broader xml:lang="en">bfo : process (15)</skos:broader>
        <skos:definition xml:lang="en">a process is an entity unfolding in time, taking place in an area and affecting the entities on it</skos:definition>
        <skos:prefLabel xml:lang="de">Prozess</skos:prefLabel>
        <skos:prefLabel xml:lang="es">proceso</skos:prefLabel>
        <skos:prefLabel xml:lang="en">process</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#Quality -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#Quality">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#inYear"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:broader xml:lang="en">bfo : specifically dependent continuant (20)</skos:broader>
        <skos:closeMatch xml:lang="en">bfo : quality (19)</skos:closeMatch>
        <skos:definition xml:lang="en">A combination of a quality inherent in a continuant and its value either as a measurement or a categorization</skos:definition>
        <skos:prefLabel xml:lang="de">Qualität</skos:prefLabel>
        <skos:prefLabel xml:lang="es">calidad</skos:prefLabel>
        <skos:prefLabel xml:lang="en">quality</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#Region -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#Region">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#desrcibedBy"/>
                <owl:someValuesFrom rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#NationalForestInventory"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#inYear"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:closeMatch xml:lang="en">bfo : two-dimensional spatial region (9)</skos:closeMatch>
        <skos:definition xml:lang="en">part of the earth surface interpreted as 2-d</skos:definition>
        <skos:note xml:lang="en">In colloquial speech area can also have the same meaning as region. In the compound terms like &apos;forest area&apos; and similar it has this meaning and these terms are established.  A compound term like &apos;forest region&apos; would imply a different meaning in colloquial language than intended</skos:note>
        <skos:prefLabel xml:lang="de">Gebiet</skos:prefLabel>
        <skos:prefLabel xml:lang="en">region</skos:prefLabel>
        <skos:prefLabel xml:lang="es">región</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#Sample -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#Sample">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#collectedOnArea"/>
                <owl:someValuesFrom rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#SampleArea"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#describedByPlot"/>
                <owl:someValuesFrom rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#Plot"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#isPartOf"/>
                <owl:someValuesFrom rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#PlotForestCommunity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#inYear"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:broader rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:broader xml:lang="en">bfo : object aggregate (27)</skos:broader>
        <skos:definition xml:lang="en">A collection of entities which is chosen for measurements or data recordings. It is  a subset of a larger collection of entities (population).</skos:definition>
        <skos:prefLabel xml:lang="de">Probe</skos:prefLabel>
        <skos:prefLabel xml:lang="es">muestra</skos:prefLabel>
        <skos:prefLabel xml:lang="en">sample</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#SampleArea -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#SampleArea">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#PlotArea"/>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:altLabel xml:lang="en">subplot area (FIA)</skos:altLabel>
        <skos:definition xml:lang="en">A part of a plot subarea on which the entities are located which a sample uses for measurements or data recordings.</skos:definition>
        <skos:prefLabel xml:lang="de">Probefläche</skos:prefLabel>
        <skos:prefLabel xml:lang="en">sample area</skos:prefLabel>
        <skos:prefLabel xml:lang="es">área de muestra</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#SampleOfTreesOfMinDiameter -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#SampleOfTreesOfMinDiameter">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#Sample"/>
        <skos:prefLabel xml:lang="de">Probe von Bäumen über dem Mindestdurchmesser</skos:prefLabel>
        <skos:prefLabel xml:lang="es">muestra de árboles encima del diámetro minimal</skos:prefLabel>
        <skos:prefLabel xml:lang="en">sample of trees of minimum diameter</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#Shrub -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#Shrub">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#Plant"/>
        <rdfs:isDefinedBy xml:lang="en">FAO  Forest Resource Assement - Terms and Definitions</rdfs:isDefinedBy>
        <rdfs:seeAlso rdf:resource="https://www.fao.org/forest-resources-assessment/en/"/>
        <skos:definition xml:lang="en">Woody perennial plant, generally more than 0.5 meters and less than 5 meters in height at maturity and without a single main stem and definite crown</skos:definition>
        <skos:note xml:lang="es">arbusto</skos:note>
        <skos:prefLabel xml:lang="de">Strauch</skos:prefLabel>
        <skos:prefLabel xml:lang="en">shrub</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#Stratum -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#Stratum">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#DataCollection"/>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:definition xml:lang="en">a collection of plots whose majority desrcibe entities satisfiyng certain conditions stated by this stratum</skos:definition>
        <skos:note xml:lang="en">A plot  &apos;satisfies&apos; a stratum, by the conditions stated by the stratum holding for the entities the plot desrcibes

An NFI can choose to assign plots to  strata in 2 ways: 

1. A plot is  &apos;assigned by condition&apos; if it satisfies the stratum&apos;s conditions. 
2. A plot is &apos;assigned by arae&apos; if the plot is in a map subarea which gets assigned to the stratum area corresponding to this stratum. Usually this assignation takes place by evaluating which stratum the majority of plots located in a subarea satisfy.</skos:note>
        <skos:prefLabel xml:lang="de">Stratum</skos:prefLabel>
        <skos:prefLabel xml:lang="es">estrato</skos:prefLabel>
        <skos:prefLabel xml:lang="en">stratum</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#StratumArea -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#StratumArea">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#TotalArea"/>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:definition xml:lang="en">part of a forest area for which the entities like forest community, terrain, etc in most cases satisfy the conditions stated by a stratum</skos:definition>
        <skos:prefLabel xml:lang="de">Stratumsfläche</skos:prefLabel>
        <skos:prefLabel xml:lang="en">stratum area</skos:prefLabel>
        <skos:prefLabel xml:lang="es">área de estrato</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#TotalArea -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#TotalArea">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#Region"/>
        <dcterms:description xml:lang="en">In the population-sample pattern applied on areas this is a population</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:definition xml:lang="en">A part of the earth surface for which a Forest Inventory wants to make statetments</skos:definition>
        <skos:prefLabel xml:lang="de">Gesamtfläche</skos:prefLabel>
        <skos:prefLabel xml:lang="en">total area</skos:prefLabel>
        <skos:prefLabel xml:lang="es">área total</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#Tree -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#Tree">
        <rdfs:subClassOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#Plant"/>
        <rdfs:isDefinedBy xml:lang="en">FAO  Forest Resource Assement - Terms and Definitions</rdfs:isDefinedBy>
        <rdfs:seeAlso rdf:resource="https://www.fao.org/forest-resources-assessment/en/"/>
        <skos:definition xml:lang="en">A woody perennial with a single main stem, or in the case of coppice with several stems, having a more or less definite crown.</skos:definition>
        <skos:note xml:lang="es">árbol</skos:note>
        <skos:prefLabel xml:lang="de">Baum</skos:prefLabel>
        <skos:prefLabel xml:lang="en">tree</skos:prefLabel>
    </owl:Class>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#TreeHeight -->

    <owl:Class rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#TreeHeight">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Quantity"/>
        <rdfs:isDefinedBy>Tomppo E et al 2010, National Forest Inventories: Pathways for Common Reporting, Appendix</rdfs:isDefinedBy>
        <skos:definition xml:lang="en">The height of a tree is the vertical distance between the base point and the highest point of the tree</skos:definition>
        <skos:note xml:lang="en">An instance is related by `qudt:hasQuantityKind` to `qudt:Length`

Tomppo et al base point: On level terrain the base point is the point resulting from the intersection  of the stem axis and the ground surface. On sloped terrain and on inclined trees the identification of the base point requires the previous identification of an  an intersection point. This intersection point is the highest point on the cross sectional  area that results from the intersection of the ground surface with the stem. A line through the intersection point and perpendicular to the stem axis yields the base point in these  cases.</skos:note>
        <skos:prefLabel xml:lang="de">Baumhöhe</skos:prefLabel>
        <skos:prefLabel xml:lang="es">altura de árbol</skos:prefLabel>
        <skos:prefLabel xml:lang="en">tree height</skos:prefLabel>
    </owl:Class>
</rdf:RDF>



