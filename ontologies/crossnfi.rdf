<?xml version="1.0"?>
<rdf:RDF xmlns="https://www.easi.uni-bayreuth.de/crossnfi#"
     xml:base="https://www.easi.uni-bayreuth.de/crossnfi"
     xmlns:sh="http://www.w3.org/ns/shacl#"
     xmlns:geo="http://www.opengis.net/ont/geosparql#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:qudt="http://qudt.org/schema/qudt/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://www.easi.uni-bayreuth.de/crossnfi">
        <owl:versionIRI rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#_0.1"/>
        <dcterms:description xml:lang="en">An ontology to enable ODBA access for national forest inventories (NFI)</dcterms:description>
        <rdfs:label xml:lang="en">crossnfi ontology 0.1</rdfs:label>
    </owl:Ontology>
    


