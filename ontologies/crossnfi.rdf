    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#broader -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#broader"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#closeMatch -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#closeMatch"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#note -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#note"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#prefLabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#prefLabel"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.opengis.net/ont/geosparql#sfContains -->

    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#sfContains">
        <owl:inverseOf rdf:resource="http://www.opengis.net/ont/geosparql#sfWithin"/>
        <skos:note xml:lang="en">2d-spatial parthood (location) in the sense of Keet, 2025, Ontology Engineering</skos:note>
    </owl:ObjectProperty>
    


    <!-- http://www.opengis.net/ont/geosparql#sfWithin -->

    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#sfWithin">
        <skos:note xml:lang="en">2d-spatial parthood (location) in the sense of Keet, 2025, Ontology Engineering</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#assignedByArea -->

    <owl:ObjectProperty rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#assignedByArea">
        <rdfs:subPropertyOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#assignedToStratum"/>
        <owl:inverseOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#containsPlotByArea"/>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:note xml:lang="en">The plot gets assigned to the stratum by the map subarea it is contained in being assigned to the stratum area corresponding to this stratum</skos:note>
        <skos:prefLabel xml:lang="es">asignado por área</skos:prefLabel>
        <skos:prefLabel xml:lang="en">assigned by area</skos:prefLabel>
        <skos:prefLabel xml:lang="de">zugewiesen durch Fläche</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#assignedByCondition -->

    <owl:ObjectProperty rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#assignedByCondition">
        <rdfs:subPropertyOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#assignedToStratum"/>
        <owl:inverseOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#containsPlotByCondition"/>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:note xml:lang="en">the plot is assigned to the stratum by the entities it desrcibes satisfying the conditions of the stratum</skos:note>
        <skos:prefLabel xml:lang="es">asignado por condición</skos:prefLabel>
        <skos:prefLabel xml:lang="en">assigned by condition</skos:prefLabel>
        <skos:prefLabel xml:lang="de">zugewiesen durch Bedingung</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#assignedToStratum -->

    <owl:ObjectProperty rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#assignedToStratum">
        <rdfs:subPropertyOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#isPartOf"/>
        <owl:inverseOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#hasPlotAssigned"/>
        <rdfs:domain rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#Stratum"/>
        <rdfs:range rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#Plot"/>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:prefLabel xml:lang="es">asignado al estrato</skos:prefLabel>
        <skos:prefLabel xml:lang="en">assigned to stratum</skos:prefLabel>
        <skos:prefLabel xml:lang="de">zugewiesen zum Stratum</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#collectedOnArea -->

    <owl:ObjectProperty rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#collectedOnArea">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#isPlaceForDataRecordingFor"/>
        <rdfs:domain rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#DataCollection"/>
        <rdfs:range rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#PlotArea"/>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:note xml:lang="en">Domain: a sample or a collection of data like a national forest inventory, a cluster or a plot
Range:  a plot area</skos:note>
        <skos:prefLabel xml:lang="de">aufgenommen auf</skos:prefLabel>
        <skos:prefLabel xml:lang="es">fichado en</skos:prefLabel>
        <skos:prefLabel xml:lang="en">recorded on</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#contains -->

    <owl:ObjectProperty rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#contains">
        <skos:note xml:lang="en">structural parthood in the sense of Keet, 2025 Ontology Engineering</skos:note>
        <skos:prefLabel xml:lang="en">contains</skos:prefLabel>
        <skos:prefLabel xml:lang="es">contienes</skos:prefLabel>
        <skos:prefLabel xml:lang="de">enhält</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#containsPlotByArea -->

    <owl:ObjectProperty rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#containsPlotByArea">
        <rdfs:subPropertyOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#hasPlotAssigned"/>
        <skos:definition xml:lang="en">contains a plot by the plot being located in a map subarea assigned to the stratum</skos:definition>
        <skos:prefLabel xml:lang="en">contains plot by area</skos:prefLabel>
        <skos:prefLabel xml:lang="es">contiene parcela por área</skos:prefLabel>
        <skos:prefLabel xml:lang="de">enthält Plot durch Fläche</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#containsPlotByCondition -->

    <owl:ObjectProperty rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#containsPlotByCondition">
        <rdfs:subPropertyOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#hasPlotAssigned"/>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:note xml:lang="en">a stratum contains a plot by the plot satisfying its conditions</skos:note>
        <skos:prefLabel xml:lang="en">contains plot by condition</skos:prefLabel>
        <skos:prefLabel xml:lang="es">contiene parcela por condición</skos:prefLabel>
        <skos:prefLabel xml:lang="de">enthält Plot durch Bedingung</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#describedByPlot -->

    <owl:ObjectProperty rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#describedByPlot">
        <rdfs:subPropertyOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#desrcibedBy"/>
        <owl:inverseOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#hasAsPlot"/>
        <rdfs:range rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#Plot"/>
        <skos:note xml:lang="en">Domain: 
entities for which there is data to be found at a plot. These entities are samples (of trees or other entitities), area and its terrain, forest community, forest processes

Range: 
Plot</skos:note>
        <skos:prefLabel xml:lang="de">beschriebenVonPlot</skos:prefLabel>
        <skos:prefLabel xml:lang="en">describedByPlot</skos:prefLabel>
        <skos:prefLabel xml:lang="es">describidoDeParcela</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#describes -->

    <owl:ObjectProperty rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#describes">
        <rdfs:domain rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#DataCollection"/>
        <skos:prefLabel xml:lang="de">beschreibt</skos:prefLabel>
        <skos:prefLabel xml:lang="en">describes</skos:prefLabel>
        <skos:prefLabel xml:lang="es">describes</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#desrcibedBy -->

    <owl:ObjectProperty rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#desrcibedBy">
        <rdfs:range rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#DataCollection"/>
        <skos:prefLabel xml:lang="de">beschrieben von</skos:prefLabel>
        <skos:prefLabel xml:lang="en">described by</skos:prefLabel>
        <skos:prefLabel xml:lang="es">describido de</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#hasAsPlot -->

    <owl:ObjectProperty rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#hasAsPlot">
        <rdfs:subPropertyOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#describes"/>
        <rdfs:domain rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#Plot"/>
        <skos:note xml:lang="en">Domain: 
Plot

Range: 
entities for which there is data to be found at a plot. These entities are samples (of trees or other entitities), area and its terrain, forest community, forest processes</skos:note>
        <skos:prefLabel xml:lang="de">beschreibtAlsPlot</skos:prefLabel>
        <skos:prefLabel xml:lang="en">describesAsPlot</skos:prefLabel>
        <skos:prefLabel xml:lang="es">describesComoParcela</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#hasPlotAssigned -->

    <owl:ObjectProperty rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#hasPlotAssigned">
        <rdfs:subPropertyOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#contains"/>
        <rdfs:domain rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#Stratum"/>
        <rdfs:range rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#Plot"/>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:prefLabel xml:lang="en">has plot assigned</skos:prefLabel>
        <skos:prefLabel xml:lang="de">hat Plot zugewiesen</skos:prefLabel>
        <skos:prefLabel xml:lang="es">tiene plot asignado</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#isPartOf -->

    <owl:ObjectProperty rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#isPartOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <skos:note xml:lang="en">structural parthood in the sense of Keet, 2025, Ontology Engineering</skos:note>
        <skos:prefLabel xml:lang="es">es parte de</skos:prefLabel>
        <skos:prefLabel xml:lang="en">is part of</skos:prefLabel>
        <skos:prefLabel xml:lang="de">ist Teil von</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#isPlaceForDataRecordingFor -->

    <owl:ObjectProperty rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#isPlaceForDataRecordingFor">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#PlotArea"/>
        <rdfs:range rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#DataCollection"/>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:note xml:lang="en">Domain: plot area
Range: a sample or data collections like a national forest inventory, a cluster or a plot</skos:note>
        <skos:prefLabel xml:lang="es">es lugar de registro de datos de</skos:prefLabel>
        <skos:prefLabel xml:lang="en">is place of data recording for</skos:prefLabel>
        <skos:prefLabel xml:lang="de">ist Ort der Datenaufnahme von</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#isStageFor -->

    <owl:ObjectProperty rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#isStageFor">
        <owl:inverseOf rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#takesPlaceIn"/>
        <rdfs:domain rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#Region"/>
        <rdfs:range rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#Process"/>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:prefLabel xml:lang="es">es escenarío de</skos:prefLabel>
        <skos:prefLabel xml:lang="en">is stage for</skos:prefLabel>
        <skos:prefLabel xml:lang="de">ist Bühne für</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://www.easi.uni-bayreuth.de/crossnfi#takesPlaceIn -->

    <owl:ObjectProperty rdf:about="https://www.easi.uni-bayreuth.de/crossnfi#takesPlaceIn">
        <rdfs:domain rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#Process"/>
        <rdfs:range rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi#Region"/>
        <rdfs:isDefinedBy rdf:resource="https://www.easi.uni-bayreuth.de/crossnfi"/>
        <skos:prefLabel xml:lang="de">findet statt in</skos:prefLabel>
        <skos:prefLabel xml:lang="es">ocurres en</skos:prefLabel>
        <skos:prefLabel xml:lang="en">takes place in</skos:prefLabel>
    </owl:ObjectProperty>
    


