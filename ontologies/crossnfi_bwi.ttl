###  https://www.easi.uni-bayreuth.de/crossnfi#ForestPlotSubarea
cnfi:ForestPlotSubarea rdf:type owl:Class .


###  https://www.easi.uni-bayreuth.de/crossnfi_bwi#StandPlotSubarea
:StandPlotSubarea rdf:type owl:Class ;
                  rdfs:subClassOf cnfi:ForestPlotSubarea ;
                  <http://www.w3.org/2004/02/skos/core#definition> "intersection of a forest stand with a plot main area. A forest stand is an area with a similar composition of tree species in a similar age group."@en ,
                                                                   "subareá de parcela de existencia"@es ;
                  <http://www.w3.org/2004/02/skos/core#note> "BWI only chooses trees from this area for DBH and height measurements. So this is not relevant on a temporarily nonstocked forest area"@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Bestandes Plot-Teilfläche"@de ,
                                                                  "stand plot subarea"@en .


